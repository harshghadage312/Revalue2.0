# ==============================================================================
# ReValue Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file or production secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=ReValue
APP_VERSION=1.0.0

# Server URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
# For local dev without running mongod, leave as "memory" or local URI.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/revalue_db?retryWrites=true&w=majority
MONGODB_DB_NAME=revalue_db
MONGODB_TIMEOUT_MS=3000

# Authentication & Security
# Generate secure keys: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_secure_random_64_character_hex_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset Token Expiry (minutes)
PASSWORD_RESET_EXPIRE_MINUTES=15

# File Upload & Storage Configuration
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads/products
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_LISTING=6
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Email Provider Configuration (Gmail SMTP)
# To configure Gmail SMTP for sending registration OTP verification emails:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to 'App passwords' under 2-Step Verification: https://myaccount.google.com/apppasswords
# 3. Create a new App Password named 'ReValue' (Google generates a 16-character password).
# 4. Set SMTP_ENABLED=true and paste your Gmail address and 16-character password below.
# If left disabled (SMTP_ENABLED=false), the system runs in safe development mode without sending actual emails.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=revalue26@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM=revalue26@gmail.com
SMTP_FROM_NAME="ReValue Marketplace"

# Payment Provider Configuration
# Supported providers: "sandbox" (for local testing/dev), "razorpay" (for India marketplace deployment), "disabled"
PAYMENT_PROVIDER=sandbox
PAYMENT_CURRENCY=INR

# Razorpay Production / Sandbox Credentials
# Sign up at https://razorpay.com/ to obtain merchant API keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Marketplace Payout / Hold Policy
# Payout release holds funds until receipt is confirmed or hold duration expires without dispute
PAYMENT_RELEASE_HOLD_HOURS=48

# Machine Learning Models
PRICE_MODEL_PATH=./ml/price_prediction/artifacts/mindvalue_random_forest_model.pkl
MOBILE_CONDITION_MODEL_PATH=./ml/mobile_condition/artifacts/mobilenet_condition.keras

# Admin Provisioning (Used during bootstrap seed script only)
INITIAL_ADMIN_EMAIL=admin@revalue.market
INITIAL_ADMIN_PASSWORD=AdminSecurePass!2026
INITIAL_ADMIN_NAME="System Administrator"
